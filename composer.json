{
  "name": "salesgo/salesgo-api",
  "type": "project",
  "description": "Offline-first Sales Force Automation API",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "google/auth": "^1.48"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "post-autoload-dump": ["@php artisan package:discover --ansi"], "test": ["@php artisan test"], "lint": ["@php vendor/bin/pint --test"] },
  "minimum-stability": "stable",
  "prefer-stable": true
}
