APP_NAME=SalesGoApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salesgo_api
DB_USERNAME=root
DB_PASSWORD=
# Token individual tetap diberi expires_at pukul 00:00 WIB oleh AuthController.
SANCTUM_EXPIRATION=1440
QUEUE_CONNECTION=database
# Local development does not require a database cache table.
CACHE_STORE=file
SALES_LOCATION_RETENTION_DAYS=90
REPORT_AGGREGATE_LOOKBACK_DAYS=7
REPORT_ARCHIVE_RETENTION_DAYS=2555
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Set only in the deployment environment; never commit the service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Required only when creating the IT account with ItAdministratorSeeder.
IT_ADMIN_USERNAME=it.admin
IT_ADMIN_EMAIL=it@example.test
IT_ADMIN_PASSWORD=
IT_ADMIN_INCREMENT=1
